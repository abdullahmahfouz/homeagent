# ── Secrets (server-side only — never prefix these with VITE_) ────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
REPLIERS_API_KEY=your-repliers-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of the deployed frontend origin(s). Leave empty for the
# single-service deploy (this backend serves the built SPA, so requests are
# same-origin and need no CORS entry). Never use "*".
# ALLOWED_ORIGINS=https://homeagent.onrender.com
# Dev only: adds http://localhost:5173 etc. to the allow-list.
# ALLOW_LOCAL_ORIGINS=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-IP limits on the Gemini-backed endpoints (";"-separated windows).
# Defaults are sized for the Gemini free tier (5 RPM, 20 requests/day).
# RATE_LIMIT_CHAT=2/minute;4/day
# Per-IP limit on /health, /usage and session reset.
# RATE_LIMIT_ADMIN=60/minute
# Per-session limit (requests per minute for one session_id).
# SESSION_LIMIT_PER_MINUTE=2
# Read the client IP from X-Forwarded-For. Keep 1 behind a proxy (Render);
# set 0 if the server is exposed directly, since the header is spoofable.
# TRUST_PROXY_HEADERS=1

# ── Request size guards ───────────────────────────────────────────────────────
# MAX_MESSAGE_CHARS=2000
# MAX_BODY_BYTES=32768

# ── Spend guard (short-circuits with a friendly 503 once a ceiling is hit) ────
# NOTE: one chat turn costs 2-3 Gemini calls (the agent loop re-calls the model
# after each tool result), so these count API CALLS, not HTTP requests.
# Daily/monthly counters roll over at UTC midnight / month start. 0 disables.
# MAX_GEMINI_CALLS_PER_DAY=18        # free tier account-wide quota is 20
# MAX_GEMINI_CALLS_PER_MINUTE=4      # free tier RPM is 5
# MAX_GEMINI_CALLS_PER_MONTH=400
# CALLS_RESERVED_PER_TURN=2          # headroom required to start a turn
# MAX_TOKENS_PER_DAY=1000000
# MAX_TOKENS_PER_MONTH=10000000
# Optional: persist counters across restarts (in-memory only if unset).
# BUDGET_STATE_FILE=./budget-state.json
# Max concurrent in-memory sessions before the oldest is evicted.
# MAX_SESSIONS=1000

# ── Frontend (public, safe to ship in the bundle) ─────────────────────────────
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token-here
